{
  "name": "polaris-vue-elements",
  "version": "0.5.0",
  "description": "Typed Vue 3 components for Shopify Polaris web components — build Shopify app UIs (App Home) in Vue with props, events and v-model.",
  "license": "MIT",
  "homepage": "https://polaris-vue-elements.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HQCuong/polaris-vue.git"
  },
  "keywords": [
    "shopify",
    "shopify-app",
    "shopify-polaris",
    "polaris",
    "app-home",
    "web-components",
    "custom-elements",
    "vue",
    "vue3",
    "typescript",
    "wrapper"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./elements": {
      "types": "./dist/generated/elements.d.ts"
    },
    "./app-bridge": {
      "types": "./dist/app-bridge/index.d.ts",
      "import": "./dist/app-bridge/index.js"
    },
    "./app-bridge/elements": {
      "types": "./dist/app-bridge/elements.d.ts"
    },
    "./tokens.css": "./tokens/tokens.css",
    "./tokens.json": "./tokens/tokens.json"
  },
  "files": [
    "dist",
    "tokens/tokens.css",
    "tokens/tokens.json",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "simple-git-hooks": {
    "pre-push": "npm run check"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "prepublishOnly": "npm run type-check && vitest run && npm run build:lib",
    "check": "oxlint . && eslint . && oxfmt --check src/ && npm run type-check",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.lib.json",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/",
    "generate": "node scripts/generate.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:generate": "node scripts/generate-docs.mjs"
  },
  "peerDependencies": {
    "@shopify/app-bridge-types": ">=0.7.4",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@shopify/app-bridge-types": {
      "optional": true
    }
  },
  "devDependencies": {
    "@shopify/app-bridge-types": "^0.7.4",
    "@shopify/polaris-types": "^2.0.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.93.0",
    "eslint-plugin-vue": "~10.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.0",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.78.0",
    "oxlint": "~1.93.0",
    "postcss": "^8.5.32",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.40",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.23.4 || ^24.22.1 || >=26.12.1",
      "onFail": "error"
    }
  },
  "overrides": {
    "vitepress": {
      "vite": "^6.4.5"
    },
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
    "js-beautify": {
      "glob": "^14.0.2"
    }
  }
}
